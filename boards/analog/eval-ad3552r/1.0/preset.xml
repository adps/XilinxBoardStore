<?xml version="1.0" encoding="UTF-8" standalone="no" ?> 
<!--DOCTYPE ip_presets SYSTEM "D:\xilinx\Vivado\2020.2\data\boards\board_schemas\current\preset.dtd"-->
<ip_presets schema="2.2">

    <!-- QUAD SPI PRESET (For 'quad_spi' mode) -->
	<ip_preset preset_proc_name="fmc_lpc_spi_preset">
        <ip vendor="xilinx.com" library="ip" name="axi_quad_spi" ip_interface="SPI_0">
            <user_parameters>
				<user_parameter name="CONFIG.C_SPI_MODE" value="2"/> <!-- Quad SPI Mode -->
				<user_parameter name="CONFIG.C_SCK_RATIO" value="2"/>
				<user_parameter name="CONFIG.C_FIFO_DEPTH" value="16" />
				<user_parameter name="CONFIG.C_USE_STARTUP" value="0" />
				<user_parameter name="CONFIG.C_NUM_SS_BITS" value="1"/>
            </user_parameters>
        </ip>
    </ip_preset>
    
    <!-- CLASSIC SPI PRESET (For 'classic_spi' mode) -->
    <ip_preset preset_proc_name="fmc_lpc_spi_classic_preset">
        <ip vendor="xilinx.com" library="ip" name="axi_quad_spi" ip_interface="SPI_0">
            <user_parameters>
				<user_parameter name="CONFIG.C_SPI_MODE" value="0"/> <!-- Standard SPI Mode -->
				<user_parameter name="CONFIG.C_SCK_RATIO" value="2"/>
				<user_parameter name="CONFIG.C_FIFO_DEPTH" value="16" />
				<user_parameter name="CONFIG.C_USE_STARTUP" value="0" />
				<user_parameter name="CONFIG.C_NUM_SS_BITS" value="1"/>
            </user_parameters>
        </ip>
    </ip_preset>

    <!-- GPIO PRESET (Matches 'fmc_gpio_preset' in board.xml) -->
    <ip_preset preset_proc_name="fmc_gpio_preset">
        <ip vendor="xilinx.com" library="ip" name="axi_gpio" ip_interface="GPIO">
            <user_parameters>
                <user_parameter name="CONFIG.C_GPIO_WIDTH" value="11"/> <!-- 11 Bits -->
                <user_parameter name="CONFIG.C_ALL_OUTPUTS" value="0"/> <!-- Mixed I/O -->
                <user_parameter name="CONFIG.C_ALL_INPUTS" value="0"/>
                <user_parameter name="CONFIG.C_IS_DUAL" value="0"/>
            </user_parameters>
        </ip>
    </ip_preset>
    
    <!-- I2C PRESET (Matches 'fmc_iic_preset' in board.xml) -->
    <ip_preset preset_proc_name="fmc_iic_preset">
        <ip vendor="xilinx.com" library="ip" name="axi_iic" ip_interface="IIC">
            <user_parameters>
                <user_parameter name="CONFIG.C_GPO_WIDTH" value="1"/>
            </user_parameters>
        </ip>
    </ip_preset>
	
</ip_presets>
